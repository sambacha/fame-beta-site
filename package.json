{
  "name": "fame-protocol-landing",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "sources": "bun scripts/generate-content-sources.mts",
    "lint": "eslint . && biome check src scripts",
    "lint:fix": "eslint . --fix && biome check --write src scripts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write src scripts",
    "prebuild": "bun scripts/generate-content-sources.mts",
    "build": "STATIC_EXPORT=1 next build && rm -rf out && mv .next-export out && find out -name '*.map' -delete",
    "start": "node scripts/serve.mjs out",
    "verify:artifacts": "node scripts/verify-artifacts.mjs --root out --base /fame-program --site-url https://fairmeme3.github.io/fame-program",
    "test:smoke": "node scripts/smoke.mjs --root out --mount /fame-program --site-url https://fairmeme3.github.io/fame-program",
    "test": "bun run build:pages && bun run verify:artifacts && bun run test:smoke",
    "build:pages": "NEXT_PUBLIC_SITE_URL=https://fairmeme3.github.io/fame-program NEXT_PUBLIC_BASE_PATH=/fame-program bun run build"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@oxide/design-system": "^6.8.0",
    "@radix-ui/react-toast": "^1.2.14",
    "@tremor/react": "^3.18.7",
    "clsx": "^2.1.1",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
