{
  "name": "fame-protocol-landing",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "sources": "bun scripts/generate-content-sources.mts",
    "shells": "bun scripts/emit-shells.mts",
    "lint": "eslint . && biome check src scripts",
    "lint:fix": "eslint . --fix && biome check --write src scripts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write src scripts",
    "build": "bun run sources && vite build && bun run shells",
    "build:pages": "VITE_SITE_URL=https://fairmeme3.github.io VITE_BASE_PATH=/fame-program bun run build",
    "build:root": "VITE_SITE_URL=https://fame-protocol.pages.dev bun run build",
    "start": "node scripts/serve.mjs --root dist",
    "verify:artifacts": "node scripts/verify-artifacts.mjs --root dist --base /fame-program --site-url https://fairmeme3.github.io/fame-program",
    "test:smoke": "node scripts/smoke.mjs --root dist --mount /fame-program --site-url https://fairmeme3.github.io/fame-program",
    "test": "bun run build:pages && bun run verify:artifacts && bun run test:smoke",
    "deploy:pages": "bun run build:pages && node scripts/deploy-pages.mjs",
    "deploy:pages:dry-run": "bun run build:pages && node scripts/deploy-pages.mjs --dry-run",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "deploy:cloudflare:dry-run": "node scripts/deploy-cloudflare.mjs --dry-run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "preact": "^10.27.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@oxide/design-system": "^6.8.0",
    "@preact/preset-vite": "^2.10.2",
    "@tailwindcss/vite": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^6.1.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.1.10"
  }
}
